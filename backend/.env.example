# LIFEOS Environment Configuration Template
# Copy this file to .env before starting the server

# ─── Database ────────────────────────────────────────
# Default: Zero-config SQLite (local development and automated testing)
DATABASE_URL=sqlite+aiosqlite:///./lifeos.db
DATABASE_URL_SYNC=sqlite:///./lifeos.db

# Production / PostgreSQL alternative:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lifeos
# DATABASE_URL_SYNC=postgresql+psycopg2://user:password@localhost:5432/lifeos

# ─── Security ────────────────────────────────────────
SECRET_KEY=lifeos-dev-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── ChromaDB ────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=data/chroma_db

# ─── Application ─────────────────────────────────────
APP_NAME=LIFEOS
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["*"]
